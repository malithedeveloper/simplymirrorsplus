{
  "schemaVersion": 1,
  "id": "simplymirrorsplus",
  "version": "${version}",
  "name": "Simply Mirrors Plus",
  "description": "Craftable full-block frameless mirrors with live reflections, mirror-in-mirror rendering and in-game reflection settings. Based on Simply Mirrors Plus by NsTut. 1.21.4 port and additions by malidev.",
  "authors": [
    "NsTut"
  ],
  "contributors": [
    "malidev"
  ],
  "license": "MIT",
  "environment": "*",
  "contact": {
    "sources": "https://github.com/malithedeveloper/simplymirrorsplus",
    "issues": "https://github.com/malithedeveloper/simplymirrorsplus/issues"
  },
  "entrypoints": {
    "main": [
      "com.malidev.simplymirrorsplus.fabric.SimplyMirrorsPlusFabric"
    ],
    "client": [
      "com.malidev.simplymirrorsplus.fabric.SimplyMirrorsPlusFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "simplymirrorsplus.mixins.json"
  ],
  "icon": "assets/simplymirrorsplus/icon.png"
}
