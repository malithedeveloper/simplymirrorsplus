{
  "schemaVersion": 1,
  "id": "simply_mirrors",
  "version": "${version}",
  "name": "Simply Mirrors",
  "description": "Craftable full-block frameless mirrors with live reflections on all six faces and in-game reflection settings. Original mod by NsTut. 1.21.4 port and fixes by malidev.",
  "authors": [
    "NsTut"
  ],
  "contributors": [
    "malidev"
  ],
  "license": "MIT",
  "environment": "*",
  "contact": {
    "sources": "https://github.com/malithedeveloper/Simply-Mirrors",
    "issues": "https://github.com/malithedeveloper/Simply-Mirrors/issues"
  },
  "entrypoints": {
    "main": [
      "com.nstut.simplymirrors.fabric.SimplyMirrorsFabric"
    ],
    "client": [
      "com.nstut.simplymirrors.fabric.SimplyMirrorsFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "simplymirrors.mixins.json"
  ],
  "icon": "assets/simply_mirrors/icon.png"
}
